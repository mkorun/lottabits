{{define "booklet"}}{{template "head" .}}{{range .Pages}}<section class="page sheet">
{{range .Data}}<div class="a5 {{.Kind}}">{{template "a5" (half $ .)}}</div>
{{end}}</section>
{{end}}{{template "tail"}}{{end}}

{{define "a5"}}{{$d := .Doc}}{{$p := .Half}}{{if eq $p.Kind "content"}}<header class="a5head"><span>{{t $d.Title}}{{if eq $d.Booklet "passphrase"}} · {{$d.Extra}}{{end}}</span><span>{{t "page"}} {{$p.Number}}</span></header>
<div class="a5body">{{if eq $d.Booklet "seed"}}{{template "seed-group" $p.Data}}{{else}}{{template "pp-group" $p.Data}}{{end}}</div>
{{else if eq $p.Kind "front"}}<div class="a5body cover-front">
<p class="brand">LottaBits</p>
<h1>{{t $d.Title}}</h1>
<p class="subtitle">{{if eq $d.Booklet "seed"}}{{t "booklet_front_seed"}}{{else}}{{$d.Extra}}<br>{{t "booklet_front_pp"}}{{end}}</p>
<p class="claim">{{t "quick_principle"}}</p>
</div>
{{else if eq $p.Kind "back"}}<div class="a5body ref">
<h2>{{t "booklet_print_title"}}</h2>
<ol class="steps"><li>{{t "booklet_print_1"}}</li><li>{{t "booklet_print_2"}}</li><li>{{t "booklet_print_3"}}</li></ol>
<p class="note">{{t "booklet_hash_note"}}</p>
</div>
{{else if eq $p.Kind "inside-front"}}<div class="a5body ref">
<h2>{{t "booklet_use_title"}}</h2>
{{if eq $d.Booklet "seed"}}<ol class="steps"><li>{{t "seed_step_1"}}</li><li>{{t "seed_step_3"}}</li><li>{{t "seed_step_4"}}</li></ol>
<p>{{t "ref_first_draw_text"}}</p>{{else}}<ol class="steps"><li>{{t "pp_step_1"}}</li><li>{{t "pp_step_2"}}</li><li>{{t "pp_use"}}</li></ol>{{end}}
</div>
{{else}}<div class="a5body ref">
{{if eq $d.Booklet "seed"}}<h2>{{t "ref_blocks"}}</h2>{{template "block-table" $p.Data}}
<ol class="steps"><li>{{t "ref_w24_a"}}</li><li>{{t "ref_w24_b"}}</li></ol>
<p class="warn">{{t "ref_never_position"}}</p>{{else}}<h2>{{t "col_strength"}}</h2>{{template "strength" $p.Data}}
<p class="note">{{t "pp_strength_note"}}</p>{{end}}
</div>
{{end}}<footer class="a5foot"><span>LottaBits {{$d.Version}}{{if ne $p.Kind "content"}}{{range $d.IDs}} · {{.}}{{end}} · {{t "license"}}{{end}}</span><span>{{if $p.Hash}}{{t "data"}} <span class="hash">{{$p.Hash}}</span>{{end}}</span></footer>
{{end}}

{{define "seed-group"}}<h2><span class="first"><u>{{two .Low}}</u> / <u>{{two .High}}</u></span><span class="bits">{{t "first_draw"}}: <u>{{two .Low}}</u> → {{t "extra_bit"}} 0 · <u>{{two .High}}</u> → {{t "extra_bit"}} 1</span></h2>
<table class="entries">
<thead><tr><th>{{t "col_second"}}</th><th>{{t "col_number"}}</th><th>{{t "col_word"}}</th><th class="sep"></th><th>{{t "col_second"}}</th><th>{{t "col_number"}}</th><th>{{t "col_word"}}</th></tr></thead>
<tbody>
{{range $i, $r := .Rows}}<tr{{if odd $i}} class="shade"{{end}}>{{range $j, $e := $r}}{{if $j}}<td class="sep"></td>{{end}}<td class="b"><u>{{two $e.Second}}</u></td><td class="n">{{four $e.Number}}</td><td class="w">{{$e.Word}}</td>{{end}}</tr>
{{end}}</tbody>
</table>{{end}}

{{define "pp-group"}}<h2><span>{{t "first_draw"}} <u class="first">{{two .First}}</u></span></h2>
<table class="entries pp">
<thead><tr><th>{{t "col_second"}}</th><th>{{t "col_word"}}</th><th class="sep"></th><th>{{t "col_second"}}</th><th>{{t "col_word"}}</th><th class="sep"></th><th>{{t "col_second"}}</th><th>{{t "col_word"}}</th></tr></thead>
<tbody>
{{range $i, $r := .Rows}}<tr{{if odd $i}} class="shade"{{end}}>{{range $j, $e := $r}}{{if $j}}<td class="sep"></td>{{end}}<td class="b"><u>{{two $e.Second}}</u></td><td class="w">{{$e.Word}}</td>{{end}}</tr>
{{end}}</tbody>
</table>{{end}}

{{define "block-table"}}<table class="blocks">
<thead><tr><th>{{t "col_bits"}}</th><th>{{t "col_block"}}</th><th>{{t "col_numbers"}}</th><th>{{t "col_first_word"}}</th><th>{{t "col_last_word"}}</th></tr></thead>
<tbody>
{{range .}}<tr class="block"><td class="bits">{{.Bits}}</td><td>{{.Block}}</td><td class="range">{{four .From}}–{{four .To}}</td><td class="w">{{.FirstWord}}</td><td class="w">{{.LastWord}}</td></tr>
{{end}}</tbody>
</table>{{end}}
