{{define "password-map"}}{{template "head" .}}{{range .Pages}}{{template "pagestart" (ctx $ .)}}
<p class="note">{{t "class_D"}} · {{t "class_U"}} · {{t "class_L"}} · {{t "class_S"}}</p>
<div class="map">
{{range .Data}}<div class="cell"><span class="n"><u>{{two .N}}</u></span><span class="k">{{.Class}}</span><span class="glyph">{{.Char}}</span><span class="name">{{if .NameKey}}{{t .NameKey}}{{end}}</span></div>
{{end}}</div>
{{template "pageend" (ctx $ .)}}{{end}}{{template "tail"}}{{end}}

{{define "password-record"}}{{template "head" .}}{{range .Pages}}{{template "pagestart" (ctx $ .)}}
<ol class="steps"><li>{{t "pw_step_1"}}</li><li>{{t "pw_step_2"}}</li></ol>
<p class="note">{{t "pw_note"}}</p>
<div class="halves">
{{range $part := split (index $.Extra "Rows") 2}}<table class="record half">
<thead><tr><th>#</th><th>{{t "col_draw"}}</th><th>{{t "col_character"}}</th><th>{{t "col_class"}}</th></tr></thead>
<tbody>
{{range $part}}<tr><td class="num">{{two .}}</td><td><span class="circle"></span></td><td><span class="box" style="width: 14mm"></span></td><td><span class="box" style="width: 8mm"></span></td></tr>
{{end}}</tbody>
</table>
{{end}}</div>
{{template "strength" (index $.Extra "Strength")}}
{{template "pageend" (ctx $ .)}}{{end}}{{template "tail"}}{{end}}
