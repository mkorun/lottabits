{{define "seed-record"}}{{template "head" .}}{{range .Pages}}{{template "pagestart" (ctx $ .)}}
<ol class="steps"><li>{{t "seed_step_1"}}</li><li>{{t "seed_step_2"}}</li><li>{{t "seed_step_3"}}</li><li>{{t "seed_step_4"}}</li></ol>
<table class="record">
<thead><tr><th>#</th><th>{{t "col_first_draw"}}</th><th>{{t "col_second_draw"}}</th><th>{{t "col_number"}}</th><th>{{t "col_word"}}</th><th>{{t "col_extra"}}</th></tr></thead>
<tbody>
{{range $.Extra}}<tr><td class="num">{{two .}}</td><td><span class="circle"></span></td><td><span class="circle"></span></td><td><span class="box" style="width: 16mm"></span></td><td><span class="box" style="width: 55mm"></span></td>{{if le . 3}}<td><span class="box" style="width: 8mm"></span></td>{{else}}<td class="off"></td>{{end}}</tr>
{{end}}<tr><td class="num">24</td><td class="off"></td><td class="off"></td><td><span class="box" style="width: 16mm"></span></td><td><span class="box" style="width: 55mm"></span></td><td class="off"></td></tr>
</tbody>
</table>
<p class="note">{{t "seed_row24"}}: {{t "seed_row24_hint"}} <span class="box" style="width: 12mm"></span> → <span class="box" style="width: 30mm"></span></p>
<p class="note">{{t "seed_record_note"}}</p>
{{template "pageend" (ctx $ .)}}{{end}}{{template "tail"}}{{end}}

{{define "seed-reference"}}{{template "head" .}}{{range .Pages}}{{template "pagestart" (ctx $ .)}}
<div class="ref">
<h2>{{t "ref_procedure"}}</h2><p>{{t "ref_procedure_text"}}</p>
<h2>{{t "ref_first_draw"}}</h2><p>{{t "ref_first_draw_text"}}</p>
<h2>{{t "ref_blocks"}}</h2>
{{template "block-table" $.Extra}}
<h2>{{t "ref_word24"}}</h2>
<ol class="steps"><li>{{t "ref_w24_a"}}</li><li>{{t "ref_w24_b"}}</li><li>{{t "ref_w24_c"}}</li></ol>
<p class="warn">{{t "ref_never_position"}}</p>
</div>
{{template "pageend" (ctx $ .)}}{{end}}{{template "tail"}}{{end}}
